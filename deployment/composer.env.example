# Cloud Composer / Airflow continuous training placeholders.
# Copy into a local, uncommitted environment file only when preparing a real
# Composer demonstration. Do not commit real project IDs, bucket names,
# credentials, or service account details.

PROJECT_ID=your-gcp-project-id
REGION=europe-west2
COMPOSER_ENVIRONMENT=predictive-maintenance-composer
COMPOSER_BUCKET=gs://your-composer-bucket
DAG_NAME=predictive_maintenance_continuous_training
SCHEDULE_CRON=0 6 * * 1
VERTEX_STAGING_BUCKET=gs://your-vertex-staging-bucket
FEATURE_TABLE_URI=gs://your-bucket/data/feature_table.csv
MODEL_OUTPUT_URI=gs://your-bucket/models/predictive-maintenance/
VERTEX_TRAINING_JOB_NAME=predictive-maintenance-training
VERTEX_MODEL_DISPLAY_NAME=predictive-maintenance-model
APPROVAL_THRESHOLD_F1=0.80
APPROVAL_THRESHOLD_RECALL=0.80
