# Vertex AI endpoint and prediction placeholders.
# Copy these values into a local, uncommitted environment file before running
# any real GCP commands. Do not commit real project IDs, endpoint IDs, bucket
# names, credentials, or service account details.

# Google Cloud project placeholder.
PROJECT_ID=your-gcp-project-id

# GCP region for Vertex AI endpoint and prediction resources.
REGION=europe-west2

# Registered Vertex AI model ID from Model Registry.
VERTEX_MODEL_ID=your-vertex-model-id

# Display name for the future Vertex AI endpoint.
VERTEX_ENDPOINT_DISPLAY_NAME=predictive-maintenance-endpoint

# Vertex AI endpoint ID after endpoint creation.
VERTEX_ENDPOINT_ID=your-endpoint-id

# Display name for the model deployed to the endpoint.
DEPLOYED_MODEL_DISPLAY_NAME=predictive-maintenance-candidate

# Machine type and scaling settings for endpoint serving.
MACHINE_TYPE=n1-standard-2
MIN_REPLICA_COUNT=1
MAX_REPLICA_COUNT=1

# Traffic routed to the deployed model.
TRAFFIC_SPLIT_PERCENT=100

# Local example request used by the dry-run online prediction helper.
ONLINE_PREDICTION_INPUT=examples/vertex_online_prediction_request.json

# Cloud Storage input/output placeholders for future batch prediction.
BATCH_PREDICTION_INPUT_URI=gs://your-bucket/prediction-input/batch.jsonl
BATCH_PREDICTION_OUTPUT_URI=gs://your-bucket/prediction-output/
