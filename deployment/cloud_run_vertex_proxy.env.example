# Cloud Run API to Vertex AI endpoint proxy placeholders.
# Copy into a local, uncommitted environment file only when testing a real
# deployment. Do not commit real project IDs, endpoint IDs, credentials, or
# service account details.

PROJECT_ID=your-gcp-project-id
REGION=europe-west2

# Vertex AI endpoint target used by the Cloud Run service in proxy mode.
VERTEX_ENDPOINT_ID=your-endpoint-id
VERTEX_ENDPOINT_REGION=europe-west2
VERTEX_PROJECT_ID=your-gcp-project-id

# Prediction mode values: local_model or vertex_endpoint.
PREDICTION_MODE=vertex

# Existing Cloud Run FastAPI service settings.
SERVICE_NAME=predictive-maintenance-api
PORT=8080

# Proxy behaviour.
REQUEST_TIMEOUT_SECONDS=30
ENABLE_VERTEX_PROXY=false
