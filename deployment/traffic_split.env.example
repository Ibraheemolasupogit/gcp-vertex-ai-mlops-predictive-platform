# GCP project that owns the Cloud Run service.
PROJECT_ID=your-gcp-project-id

# Cloud Run region.
REGION=europe-west2

# Cloud Run service to inspect or update.
SERVICE_NAME=predictive-maintenance-api

# Existing stable revision receiving most traffic.
STABLE_REVISION=stable-revision-placeholder

# New candidate revision receiving canary traffic.
CANDIDATE_REVISION=candidate-revision-placeholder

# Traffic allocation for the stable revision.
STABLE_TRAFFIC_PERCENT=90

# Traffic allocation for the candidate revision.
CANDIDATE_TRAFFIC_PERCENT=10
