# Vertex AI custom training and Model Registry placeholders.
# Copy these values into a local, uncommitted environment file before running
# any real GCP commands. Do not commit real project IDs, bucket names, or
# service account details.

# Google Cloud project placeholder.
PROJECT_ID=your-gcp-project-id

# GCP region for Vertex AI resources.
REGION=europe-west2

# Cloud Storage bucket used by Vertex AI for staging and job outputs.
VERTEX_STAGING_BUCKET=gs://your-vertex-staging-bucket

# Human-readable Vertex AI custom training job name.
VERTEX_TRAINING_JOB_NAME=predictive-maintenance-training

# Display name for the model in Vertex AI Model Registry.
VERTEX_MODEL_DISPLAY_NAME=predictive-maintenance-model

# Candidate alias to apply to the future registered model version.
VERTEX_MODEL_VERSION_ALIAS=candidate

# Optional custom training container image if training is containerized.
TRAINING_CONTAINER_IMAGE_URI=region-docker.pkg.dev/project/repository/training-image:tag

# Serving container image URI for the already Dockerized FastAPI prediction API.
SERVING_CONTAINER_IMAGE_URI=region-docker.pkg.dev/project/repository/predictive-maintenance-api:tag

# Machine type for the future Vertex AI custom training worker pool.
TRAINING_MACHINE_TYPE=n1-standard-4

# Cloud Storage prefix where the trained model artifact would be written.
MODEL_ARTIFACT_GCS_URI=gs://your-bucket/models/predictive-maintenance-model/

# Cloud Storage path for the feature table used by the training job.
FEATURE_TABLE_GCS_URI=gs://your-bucket/data/feature_table.csv
