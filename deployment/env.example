# GCP project that will own Artifact Registry and Cloud Run resources.
PROJECT_ID=your-gcp-project-id

# Deployment region. europe-west2 is used as a placeholder; change if needed.
REGION=europe-west2

# Artifact Registry Docker repository name.
ARTIFACT_REPOSITORY=vertex-mlops-serving

# Docker image name for the FastAPI serving container.
IMAGE_NAME=predictive-maintenance-api

# Docker image tag to push. Use a version or commit SHA in real deployment evidence.
IMAGE_TAG=local

# Cloud Run service name.
SERVICE_NAME=predictive-maintenance-api

# Container port. Cloud Run injects PORT, and this image defaults to 8080.
PORT=8080

# Set to true for public demo endpoints, false for authenticated services.
ALLOW_UNAUTHENTICATED=true

# Optional: set after deployment, or pass directly to test_cloud_run_service.sh.
CLOUD_RUN_URL=https://replace-with-cloud-run-url
